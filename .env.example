# SPACE2PARK Environment Configuration
NODE_ENV=development
PORT=5000
DEMO_MODE=true

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/space2park

# Redis Lock & Cache Configuration
REDIS_URL=redis://localhost:6379

# Cryptography & Auth Secrets
JWT_SECRET=space2park-sih2026-jwt-secure-secret-key-indore
QR_SECRET=space2park-sih26205-tamperproof-hmac-key

# Google Maps Platform Keys (Optional for synthetic offline demo fallback)
VITE_GOOGLE_MAPS_API_KEY=AIzaSySyntheticDemoKeyForIndorePlatform
GOOGLE_MAPS_SERVER_KEY=AIzaSySyntheticServerKeyForIndoreDistanceMatrix

# Swappable Adapter Modes
PAYMENT_ADAPTER=simulated
NOTIFICATION_ADAPTER=in_app
STORAGE_ADAPTER=local
